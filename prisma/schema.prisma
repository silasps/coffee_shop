generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CoffeeTeamRole {
  ADMIN
  SELLER
  FINANCE
}

enum CoffeeMenuArea {
  FOODS
  HOT_DRINKS
  COLD_DRINKS
}

enum CoffeeOrderChannel {
  TABLE
  COUNTER
  TOTEM
}

enum CoffeeOrderStatus {
  AWAITING_PAYMENT
  IN_QUEUE
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum CoffeePaymentMethod {
  ONLINE_CARD
  PAY_LINK
  PIX
  PAY_AT_COUNTER
  CASH_AT_COUNTER
  CARD_AT_COUNTER
}

enum CoffeePaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CoffeeInventoryMovementType {
  PURCHASE
  ENTRY
  CONSUMPTION
  ADJUSTMENT
  WASTE
}

enum CoffeeFinanceDirection {
  INCOME
  EXPENSE
}

enum CoffeeFinanceCategory {
  SALE
  SUPPLY_PURCHASE
  OPERATIONS
  RENT
  PAYROLL
  TAXES
  UTILITIES
  MARKETING
  MAINTENANCE
  EQUIPMENT
  OTHER
  ADJUSTMENT
}

enum CoffeeBillingInvoiceStatus {
  OPEN
  PAID
  CANCELED
}

model CoffeeClientAccount {
  id    String @id @default(cuid())
  slug  String @unique
  name  String

  legalName    String?
  ownerName    String?
  billingEmail String?
  phone        String?

  monthlyFee        Decimal @default(150) @db.Decimal(10, 2)
  billingDayOfMonth Int     @default(10)
  graceDays         Int     @default(4)
  suspensionDays    Int     @default(12)

  notes    String?
  isActive Boolean @default(true)

  stores   CoffeeShopStore[]
  invoices CoffeeBillingInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("coffee_client_accounts")
}

model CoffeeBillingInvoice {
  id              String @id @default(cuid())
  clientAccountId String

  referenceMonth DateTime
  amount         Decimal                  @db.Decimal(10, 2)
  dueAt          DateTime
  paidAt         DateTime?

  reminderSentAt    DateTime?
  finalNoticeSentAt DateTime?
  status            CoffeeBillingInvoiceStatus @default(OPEN)
  notes             String?

  clientAccount CoffeeClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientAccountId, referenceMonth])
  @@index([clientAccountId, status, dueAt])
  @@map("coffee_billing_invoices")
}

model CoffeeShopStore {
  id              String @id @default(cuid())
  clientAccountId String?
  slug            String @unique
  name            String
  legalName       String?
  currencyCode    String @default("BRL")
  defaultLocale   String @default("pt")
  isActive        Boolean @default(true)

  sloganPt                String?
  sloganEn                String?
  sloganEs                String?
  storefrontDescriptionPt String?
  storefrontDescriptionEn String?
  storefrontDescriptionEs String?
  logoUrl                 String?
  brandPrimaryColor       String?
  brandSecondaryColor     String?
  brandAccentColor        String?
  contactPhone            String?
  contactWhatsapp         String?

  clientAccount      CoffeeClientAccount?   @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  categories         CoffeeCatalogCategory[]
  catalogSections    CoffeeCatalogSection[]
  products           CoffeeProduct[]
  orders             CoffeeOrder[]
  inventoryMovements CoffeeInventoryMovement[]
  financeEntries     CoffeeFinanceEntry[]
  teamMembers        CoffeeTeamMember[]
  suppliers          CoffeeSupplier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientAccountId, isActive])
  @@map("coffee_shop_stores")
}

model CoffeeCatalogSection {
  id      String @id @default(cuid())
  storeId String

  area          CoffeeMenuArea
  namePt        String
  nameEn        String?
  nameEs        String?
  descriptionPt String?
  descriptionEn String?
  descriptionEs String?
  imageUrl      String?
  sortOrder     Int     @default(0)
  isActive      Boolean @default(true)

  store CoffeeShopStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, area])
  @@index([storeId, sortOrder])
  @@map("coffee_shop_catalog_sections")
}

model CoffeeTeamMember {
  id      String @id @default(cuid())
  storeId String

  fullName       String
  email          String? @unique
  role           CoffeeTeamRole
  isActive       Boolean @default(true)
  prefersCounter Boolean @default(false)

  store CoffeeShopStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, role, isActive])
  @@map("coffee_shop_team_members")
}

model CoffeeCatalogCategory {
  id      String @id @default(cuid())
  storeId String

  area          CoffeeMenuArea
  slug          String
  namePt        String
  nameEn        String?
  nameEs        String?
  descriptionPt String?
  descriptionEn String?
  descriptionEs String?
  accentColor   String?
  sidebarImageUrl String?
  sortOrder     Int     @default(0)
  isActive      Boolean @default(true)

  store    CoffeeShopStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products CoffeeProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
  @@index([storeId, area, sortOrder])
  @@map("coffee_shop_catalog_categories")
}

model CoffeeProduct {
  id         String @id @default(cuid())
  storeId    String
  categoryId String

  slug          String
  sku           String?
  namePt        String
  nameEn        String?
  nameEs        String?
  descriptionPt String?
  descriptionEn String?
  descriptionEs String?
  imageUrl      String?
  artTone       String?
  highlightPt   String?
  highlightEn   String?
  highlightEs   String?

  basePrice     Decimal? @db.Decimal(10, 2)
  stockQuantity Int?
  prepMinutes   Int?

  isAvailable Boolean @default(true)
  isFeatured  Boolean @default(false)
  sortOrder   Int     @default(0)

  store            CoffeeShopStore          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category         CoffeeCatalogCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems       CoffeeOrderItem[]
  inventoryEntries CoffeeInventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
  @@index([storeId, categoryId, sortOrder])
  @@index([storeId, isAvailable])
  @@map("coffee_shop_products")
}

model CoffeeOrder {
  id      String @id @default(cuid())
  storeId String

  displayCode  String @unique
  customerName String
  tableLabel   String?
  notes        String?

  channel       CoffeeOrderChannel
  status        CoffeeOrderStatus
  paymentMethod CoffeePaymentMethod
  paymentStatus CoffeePaymentStatus @default(PENDING)

  subtotal Decimal @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  requiresCounterPayment Boolean  @default(false)
  canStartPreparation    Boolean  @default(false)
  paidAt                 DateTime?
  readyAt                DateTime?
  completedAt            DateTime?

  store          CoffeeShopStore        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items          CoffeeOrderItem[]
  financeEntries CoffeeFinanceEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, status, createdAt])
  @@index([storeId, paymentStatus, createdAt])
  @@map("coffee_shop_orders")
}

model CoffeeOrderItem {
  id      String @id @default(cuid())
  orderId String

  productId          String?
  productSlug        String
  productNamePt      String
  productDescription String?
  notes              String?
  quantity           Int
  unitPrice          Decimal? @db.Decimal(10, 2)
  totalPrice         Decimal? @db.Decimal(10, 2)

  order   CoffeeOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product CoffeeProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@map("coffee_shop_order_items")
}

model CoffeeInventoryMovement {
  id      String @id @default(cuid())
  storeId String

  productId String?
  supplierId String?

  titlePt     String
  description String?
  type        CoffeeInventoryMovementType
  quantity    Decimal? @db.Decimal(10, 2)
  unitLabel   String?
  unitCost    Decimal? @db.Decimal(10, 2)
  totalAmount Decimal? @db.Decimal(10, 2)
  referenceCode String?

  happenedAt DateTime @default(now())

  store   CoffeeShopStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product CoffeeProduct?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  supplier CoffeeSupplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  financeEntries CoffeeFinanceEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, type, happenedAt])
  @@map("coffee_shop_inventory_movements")
}

model CoffeeFinanceEntry {
  id      String @id @default(cuid())
  storeId String

  orderId             String?
  inventoryMovementId String?
  supplierId          String?

  direction     CoffeeFinanceDirection
  category      CoffeeFinanceCategory
  descriptionPt String
  amount        Decimal @db.Decimal(10, 2)
  happenedAt    DateTime @default(now())
  referenceCode String?
  notes         String?

  store             CoffeeShopStore          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order             CoffeeOrder?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  inventoryMovement CoffeeInventoryMovement? @relation(fields: [inventoryMovementId], references: [id], onDelete: SetNull)
  supplier          CoffeeSupplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, direction, happenedAt])
  @@index([storeId, category, happenedAt])
  @@map("coffee_shop_finance_entries")
}

model CoffeeSupplier {
  id      String @id @default(cuid())
  storeId String

  name         String
  contactName  String?
  email        String?
  phone        String?
  whatsapp     String?
  documentId   String?
  paymentTerms String?
  leadTimeDays Int?
  notes        String?
  isActive     Boolean @default(true)

  store              CoffeeShopStore          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  inventoryMovements CoffeeInventoryMovement[]
  financeEntries     CoffeeFinanceEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, isActive, name])
  @@map("coffee_shop_suppliers")
}
